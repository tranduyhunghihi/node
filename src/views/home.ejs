<!DOCTYPE html>
<html lang="en">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <div class="nav-list">
        <a href="/" class="nav-item active">Home</a>
        <a href="/create" class="nav-item">Create User</a>
    </div>
    
    
    <div class="table-container">
        <h2 class="title">List Users</h2>
        <table>
            <tr>
                <th>ID</th>
                <th>EMail</th>
                <th>Name</th>
                <th>City</th>
                <th>Action</th>
            </tr>
            <% listUsers.forEach(user => { %>
            <tr>
                    <td><%= user.id %></td>
                    <td><%= user.email %></td>
                    <td><%= user.name %></td>
                    <td><%= user.city %></td>
                <td>
                    <button>Edit</button>
                    <button>Delete</button>
                </td>
            </tr>
            <% }) %>
        </table>
    </div>
</body>
</html>